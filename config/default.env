# ============================================================
# MycoWES standard runtime configuration (100 bp / MAPQ20 / NM0.08)
# ============================================================

# Programs
CUTADAPT=cutadapt
MINIMAP2=minimap2
SAMTOOLS=samtools
PYTHON=python3

# The supported Python entry point binds exactly one microbial profile.
[ "${MYCOWES_PROFILE_READY:-}" = 1 ] || {
    echo 'ERROR: use python3 mycowes.py run to select a reference profile' >&2
    return 1 2>/dev/null || exit 1
}

# Adapter trimming
ADAPTER_R1=AGATCGGAAGAGCACACGTCTGAACTCCAGTCA
ADAPTER_R2=AGATCGGAAGAGCGTCGTGTAGGGAAAGAGTGT

# Optional reference-driven adapter audit. Set all three; thresholds require
# scientific approval and intentionally have no defaults.
ADAPTER_REF_DIR=
ADAPTER_REF_MIN_OVERLAP=
ADAPTER_REF_MIN_IDENTITY=

# Fragment evidence
CORE_MIN_ALIGNED_BP=${CORE_MIN_ALIGNED_BP:-100}
CORE_MIN_MAPQ=${CORE_MIN_MAPQ:-20}
CORE_MAX_NM_RATE=${CORE_MAX_NM_RATE:-0.08}

# Anchor selection
ANCHOR_MIN_RETENTION=${ANCHOR_MIN_RETENTION:-0.90}

# Breadth / dispersion
DISPERSION_BIN_BP=${DISPERSION_BIN_BP:-250}

# Fixed rules, not configuration entries: Supportive >=3 coordinates in >=2
# bins with Fmax<0.80; Strong >=5 in >=3 bins with physical span>=300 bp and
# Fmax<=0.50. See evidence_anchor_breadth_v0.2.py:dispersion_tier.

# Execution-only CPU profile, resolved by mycowes.py run.
CUTADAPT_THREADS=${CUTADAPT_THREADS:-8}
HOST_THREADS=${HOST_THREADS:-32}
MICROBIAL_THREADS=${MICROBIAL_THREADS:-8}
SAMTOOLS_THREADS=${SAMTOOLS_THREADS:-4}

# ============================================================
# Host reference
# ============================================================

HOST_REFERENCE_PROFILE=MycoWES_GRCh38_v1

# User-installed host reference.
# May be overridden by environment variables:
# MYCOWES_HOST_FASTA
# MYCOWES_HOST_MMI

HOST_FASTA=
HOST_MMI=

# Optional four-module roots. Prefer environment overrides at runtime.
# MYCOWES_MICROBIAL_REF_ROOT=/path/to/microbial/reference
# MYCOWES_HOST_REF_ROOT=/path/to/host/reference/root
# MYCOWES_CAPTURE_ROOT=/path/to/capture/resources
# MYCOWES_INDEX_ROOT=/path/to/prebuilt/indexes
